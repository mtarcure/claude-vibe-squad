<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>CHRONO_VAULT_ROOT</key>
		<string>__HOME__/Obsidian-Chrono</string>
		<key>MCP_PORT</key>
		<string>3001</string>
		<key>MCP_TRANSPORT</key>
		<string>sse</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.chrono.chrono-vault-mcp</string>
	<key>LogFileRetention</key>
	<integer>2</integer>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/chrono/.venv/bin/python</string>
		<string>__HOME__/chrono/plugins/chrono-vault/mcp_server.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/.local/logs/chrono-vault-mcp.err</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.local/logs/chrono-vault-mcp.log</string>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>WorkingDirectory</key>
	<string>__HOME__/chrono/plugins/chrono-vault</string>
</dict>
</plist>
